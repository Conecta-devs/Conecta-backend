// use prisma-next

model User {
  id           ObjectId @id @map("_id")
  email        String   @unique
  name         String
  passwordHash String
  bio          String?
  gen          String?
  image        String?
  permissao    String?
  posts        Post[]

  @@map("users")
}

model Post {
  id       ObjectId @id @map("_id")
  title    String
  content  String?
  author   User     @relation(fields: [authorId], references: [id])
  authorId ObjectId

  @@map("posts")
}